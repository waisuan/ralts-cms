PORT=8080
# Listen address. 0.0.0.0 = all interfaces (needed for WSL2 + Windows browser). Use 127.0.0.1 for loopback-only.
HOST=0.0.0.0
# Where to send users (scheme + host, no trailing slash)
TARGET_ORIGIN=https://ralts-cms.app
# Seconds before auto-redirect. 0 = immediate HTTP 301 (no HTML).
REDIRECT_DELAY=10
LEGACY_SITE_LABEL=clown-cms.com
NEW_SITE_LABEL=ralts-cms.app

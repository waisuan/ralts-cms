# pg_dump major must be >= server major (e.g. PG 18 on Railway needs client 18).
FROM alpine:3.23

RUN apk add --no-cache \
    postgresql18-client \
    aws-cli \
    bash \
    coreutils

COPY scripts/backup-to-r2.sh /app/backup-to-r2.sh
RUN chmod +x /app/backup-to-r2.sh

WORKDIR /app
CMD ["./backup-to-r2.sh"]

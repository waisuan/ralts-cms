# Development Configuration
APP_NAME=ralts-cms
APP_ENV=development
SERVER_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
JWT_SECRET=your-jwt-secret-key

# PostgreSQL Configuration
DATABASE_URL=postgresql://ralts_user:ralts_password@localhost:5432/ralts_cms_dev?sslmode=disable
# To set pool parameters, add them to the URL, e.g.:
# DATABASE_URL=postgresql://ralts_user:ralts_password@localhost:5432/ralts_cms_dev?sslmode=disable&pool_max_conns=25&pool_min_conns=5&pool_max_conn_lifetime=5m

# S3 Configuration
S3_BUCKET_NAME=ralts-cms-attachments

# AWS/LocalStack Configuration (for development)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Set to http://localhost:4566 for LocalStack, or remove/comment for real AWS
AWS_ENDPOINT_URL=http://localhost:4566
# Force path-style for LocalStack S3 compatibility
AWS_S3_FORCE_PATH_STYLE=true
# Development Configuration
APP_NAME=ralts-cms
APP_ENV=development
SERVER_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
JWT_SECRET=your-jwt-secret-key

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ralts?sslmode=disable
# To set pool parameters, add them to the URL, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ralts?sslmode=disable&pool_max_conns=25&pool_min_conns=5&pool_max_conn_lifetime=5m
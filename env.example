# Development Configuration
APP_NAME=ralts-cms
APP_ENV=development
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=ralts
SERVER_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
CREDENTIALS=admin:password
JWT_SECRET=your-jwt-secret-key
DEFAULT_MACHINE_LIMIT=50

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ralts?sslmode=disable
# To set pool parameters, add them to the URL, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ralts?sslmode=disable&pool_max_conns=25&pool_min_conns=5&pool_max_conn_lifetime=5m

# Production Configuration (uncomment and modify as needed)
# APP_NAME=ralts-cms
# APP_ENV=production
# DYNAMODB_REGION=us-east-1
# DYNAMODB_TABLE=ralts-prod
# SERVER_PORT=8080
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# CREDENTIALS=your-production-credentials
# JWT_SECRET=your-production-jwt-secret-key
# DEFAULT_MACHINE_LIMIT=100

# PostgreSQL Configuration (Production)
# POSTGRES_HOST=your-production-host
# POSTGRES_PORT=5432
# POSTGRES_USER=your-production-user
# POSTGRES_PASSWORD=your-production-password
# POSTGRES_DB=ralts_cms
# POSTGRES_SSLMODE=require

# PostgreSQL Connection Pool Configuration (Production)
# POSTGRES_MAX_OPEN_CONNS=50
# POSTGRES_MAX_IDLE_CONNS=10
# POSTGRES_CONN_MAX_LIFETIME=10m 